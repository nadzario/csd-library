# GitHub App or fine-grained PAT with Contents + Releases write access
GITHUB_TOKEN=github_pat_replace_me
GITHUB_OWNER=nadzario
GITHUB_CATALOG_REPO=csd-catalog
GITHUB_CATALOG_BRANCH=main
# JSON mapping top-level Yandex folders to binary repositories
GITHUB_REPO_MAP={"1 курс":"csd-early","2 курс":"csd-early","3 курс":"csd-middle","4 курс":"csd-senior","5 курс":"csd-senior","6 курс":"csd-senior","3-4 (отдельные курсы)":"csd-electives","5-6 (отдельные курсы)":"csd-electives","5-6 Гайды по выживанию":"csd-electives","5-6 Спецкурсы":"csd-electives","МФК":"csd-electives","Читались в разное время":"csd-electives","Нерассортированное":"csd-misc","Полезная информация":"csd-misc","Военная кафедра":"csd-misc","Неинтегрированная магистратура":"csd-misc","default":"csd-misc"}

ADMIN_PASSWORD=change-this-long-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_TELEGRAM_IDS=123456789
TELEGRAM_BOT_TOKEN=
PUBLIC_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
PORT=3000
# Comma-separated IPs/CIDRs of reverse proxies; blank for direct connections.
TRUSTED_PROXIES=
PUBLIC_SUBMISSION_MAX_MB=95
PUBLIC_QUEUE_MAX_MB=5120
PUBLIC_QUEUE_MAX_FILES=1000
PUBLIC_UPLOAD_CONCURRENCY=4

# Static web build. Leave empty to use bundled demo catalog.
VITE_CATALOG_URL=

YANDEX_PUBLIC_URL=https://disk.yandex.ru/d/uBxTJDaahuSjZA
MIGRATION_CONCURRENCY=4
YANDEX_429_COOLDOWN_MS=900000
YANDEX_429_MAX_COOLDOWN_MS=7200000
